{
  "problemMatcher": [
    {
      "owner": "msvc",
      "pattern": [
        {
          "regexp": "^(?:\s*\d+>)?\s*([^\s].*?)\((\d+)(?:,(\d+))?\)\s*:\s+(error|warning)\s+(C\d+)\s*:\s*(.*?)(?:\s+\[.*\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
